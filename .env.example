# Copia questo file in .env.local e inserisci le tue chiavi (NON committare .env.local)

# URL pubblico del sito (per link nelle email, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (facoltativo) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM="RistOro dell'Etna <ordini@ristorodelletna.it>"
# email dello staff per notifiche prenotazioni/eventi/nuovi ordini (facoltativo)
STAFF_NOTIFY_EMAIL=

# Geocodifica indirizzi (facoltativo: senza chiave si usa OpenStreetMap Nominatim)
GOOGLE_MAPS_API_KEY=
